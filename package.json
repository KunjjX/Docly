{
    "name": "docly-cli",
    "version": "2.1.0",
    "description": "AI-powered documentation generator — transform your codebase into professional docs with a single command",
    "keywords": [
        "documentation",
        "generator",
        "cli",
        "developer-tools",
        "productivity",
        "readme",
        "srs",
        "architecture",
        "automation",
        "ai-powered",
        "mermaid",
        "diagrams"
    ],
    "homepage": "https://docly.dev",
    "bugs": {
        "url": "https://github.com/kunjjarsaniya/Docly/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kunjjarsaniya/Docly.git",
        "directory": "."
    },
    "funding": {
        "type": "github",
        "url": "https://github.com/sponsors/kunjjarsaniya"
    },
    "license": "MIT",
    "author": {
        "name": "Kunj Jarsaniya",
        "email": "kunjjarsaniya07@gmail.com",
        "url": "https://github.com/kunjjarsaniya"
    },
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./bin": {
            "default": "./dist/bin.js"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "default": "./dist/client.js"
        },
        "./config": {
            "types": "./dist/config.d.ts",
            "default": "./dist/config.js"
        },
        "./templates": {
            "types": "./dist/templates.d.ts",
            "default": "./dist/templates.js"
        },
        "./validator": {
            "types": "./dist/validator.d.ts",
            "default": "./dist/validator.js"
        },
        "./fileUtils": {
            "types": "./dist/fileUtils.d.ts",
            "default": "./dist/fileUtils.js"
        },
        "./mermaidUtils": {
            "types": "./dist/mermaidUtils.d.ts",
            "default": "./dist/mermaidUtils.js"
        },
        "./package.json": "./package.json"
    },
    "typesVersions": {
        "*": {
            "bin": ["./dist/bin.d.ts"],
            "client": ["./dist/client.d.ts"],
            "config": ["./dist/config.d.ts"],
            "templates": ["./dist/templates.d.ts"],
            "validator": ["./dist/validator.d.ts"],
            "fileUtils": ["./dist/fileUtils.d.ts"],
            "mermaidUtils": ["./dist/mermaidUtils.d.ts"]
        }
    },
    "bin": {
        "docly": "dist/bin.js"
    },
    "files": [
        "dist/",
        "scripts/postinstall.js",
        "README.md",
        "CONTRIBUTING.md",
        "SECURITY.md",
        "CODE_OF_CONDUCT.md",
        "LICENSE"
    ],
    "sideEffects": [
    "src/utils/env-loader.ts",
    "src/utils/config.ts"
],
    "engines": {
        "node": ">=18.0.0"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "start": "node dist/bin.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "biome check src/ bin/ tests/",
        "lint:fix": "biome check --write src/ bin/ tests/",
        "lint:ci": "biome ci src/ bin/ tests/",
        "format": "biome format --write src/ bin/ tests/",
        "format:check": "biome format src/ bin/ tests/",
        "typecheck": "tsc --noEmit",
        "build:types": "tsc -p tsconfig.types.json",
        "prepublishOnly": "npm run build && npm run build:types && npm run lint:ci && npm run typecheck && npm test",
        "postinstall": "node scripts/postinstall.js",
        "verify": "node scripts/verify-install.js",
        "prepack": "npm run build",
        "clean": "rm -rf dist coverage"
    },
    "dependencies": {
        "@mermaid-js/mermaid-cli": "^11.16.0",
        "axios": "^1.19.0",
        "chalk": "^5.3.0",
        "commander": "^11.1.0",
        "dotenv": "^16.3.1",
        "fs-extra": "^11.4.0",
        "ora": "^7.0.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.4",
        "@types/fs-extra": "^11.0.4",
        "@vitest/coverage-v8": "^4.1.10",
        "esbuild": "^0.28.1",
        "nodemon": "^3.0.2",
        "tsup": "^8.5.1",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    }
}
