{
    "name": "docly-cli",
    "version": "2.0.0",
    "description": "Automatically generate complete project documentation with a single command",
    "main": "src/commands/index.js",
    "type": "module",
    "bin": {
        "docly": "bin/index.js"
    },
    "scripts": {
        "start": "node bin/index.js",
        "dev": "nodemon bin/index.js",
        "build": "echo 'Build complete - ES modules used directly'",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
        "test:watch": "npm run test -- --watch",
        "test:coverage": "npm run test -- --coverage",
        "lint": "eslint src/ bin/ tests/",
        "lint:fix": "eslint src/ bin/ tests/ --fix",
        "format": "prettier --write \"src/**/*.js\" \"bin/**/*.js\" \"tests/**/*.js\"",
        "format:check": "prettier --check \"src/**/*.js\" \"bin/**/*.js\" \"tests/**/*.js\""
    },
    "keywords": [
        "documentation",
        "generator",
        "cli",
        "developer-tools",
        "productivity",
        "readme",
        "srs",
        "architecture",
        "automation",
        "ai-powered"
    ],
    "author": {
        "name": "Kunj Jarsaniya",
        "email": "kunjjarsaniya07@gmail.com"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kunjjarsaniya/Docly.git"
    },
    "engines": {
        "node": ">=16.0.0",
        "npm": ">=8.0.0"
    },
    "files": [
        "bin/",
        "src/",
        "README.md",
        "LICENSE"
    ],
    "dependencies": {
        "@mermaid-js/mermaid-cli": "^11.12.0",
        "@google/genai": "^1.34.0",
        "axios": "^1.6.2",
        "chalk": "^5.3.0",
        "commander": "^11.1.0",
        "dotenv": "^16.3.1",
        "fs-extra": "^11.2.0",
        "ora": "^7.0.1"
    },
    "devDependencies": {
        "eslint": "^8.55.0",
        "jest": "^29.7.0",
        "nodemon": "^3.0.2",
        "prettier": "^3.1.1"
    }
}