{
  "name": "docly-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "lint": "bun x eslint .",
    "cli": "bun run --cwd apps/cli",
    "docs": "bun run --cwd apps/docs",
    "verify": "bun run packages/core/scripts/verify.ts"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "latest"
  }
}